# Copy to .env and fill in. Never commit .env.

# Gemini: used by Naive RAG and Microsoft GraphRAG (graphrag_index/settings.yaml)
GEMINI_API_KEY=your-gemini-key
# Optional overrides for Naive RAG
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI: used when no Gemini key is set, and for Neo4j GraphRAG embeddings
OPENAI_API_KEY=your-openai-key

# Only needed for strategy 3 (Neo4j GraphRAG), e.g. a free Neo4j AuraDB instance
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
